# Локальний Postgres
LOCAL_DB_USER=flenta
LOCAL_DB_PASSWORD=CHANGE_ME
LOCAL_DB_NAME=flenta
LOCAL_DB_PORT=5433

# Таке саме підключення в Flenta_Backend/.env.local або в оточенні API.
# Пароль повинен збігатися з LOCAL_DB_PASSWORD; усередині контейнерів Host=db-local;Port=5432.
ConnectionStrings__AppDb=Host=127.0.0.1;Port=5433;Database=flenta;Username=flenta;Password=CHANGE_ME

# Supabase Session pooler: окремі облікові дані БД, не publishable/service_role API key.
# ConnectionStrings__AppDb=Host=YOUR_SESSION_POOLER_HOST;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=CHANGE_ME;SSL Mode=VerifyFull
